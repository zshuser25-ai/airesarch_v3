{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.kvresearch/artifact.schema.json",
  "title": "KVResearch control artifact",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "created_at",
    "producer",
    "inputs",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "artifact_type": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "created_at": {"type": "string", "pattern": "Z$"},
    "producer": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "status": {"enum": ["complete", "failed", "partial"]},
    "error_code": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}

